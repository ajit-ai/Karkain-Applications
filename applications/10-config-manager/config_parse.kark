// config_parse.kark — INI-subset parsing for A03 (Phase 005).
//
// Supported subset (NOT JSON, NOT a full INI/TOML implementation):
//   # or ; full-line comments, [section] headers, key = value pairs,
//   surrounding whitespace tolerated. Keys are stored qualified as
//   "section.key"; pairs before any section use the bare key. Lines without
//   "=" are skipped. Duplicate keys: last value wins.
//
// Returns { ok, error, data } where data maps qualified key -> value.
public func config_load(path) {
    let r = {}
    r["ok"] = 0
    r["error"] = ""
    r["data"] = {}
    let content = readFile(path)
    if (len(content) == 0) {
        r["error"] = "cannot read " + path
        return r
    }
    let data = {}
    let section = ""
    let lines = split(content, "\n")
    let i = 0
    while (i < len(lines)) {
        let line = trim(lines[i])
        i = i + 1
        if (len(line) == 0) {
            continue
        }
        if (substr(line, 0, 1) == "#") {
            continue
        }
        if (substr(line, 0, 1) == ";") {
            continue
        }
        if (substr(line, 0, 1) == "[") {
            let close = config_find(line, "]")
            if (close > 1) {
                section = trim(substr(line, 1, close - 1))
            }
            continue
        }
        let eq = config_find(line, "=")
        if (eq < 0) {
            continue
        }
        let key = trim(substr(line, 0, eq))
        let val = trim(substr(line, eq + 1, len(line) - eq - 1))
        if (len(key) == 0) {
            continue
        }
        if (len(section) > 0) {
            key = section + "." + key
        }
        data[key] = val
    }
    r["ok"] = 1
    r["data"] = data
    return r
}

// config_find returns the index of the first occurrence of sub in text.
public func config_find(text, sub) {
    let n = len(text)
    let m = len(sub)
    if (m == 0) {
        return 0
    }
    let i = 0
    while (i <= n - m) {
        if (substr(text, i, m) == sub) {
            return i
        }
        i = i + 1
    }
    return -1
}

// config_sort returns a sorted copy of a string array.
public func config_sort(keys) {
    let out = []
    let i = 0
    while (i < len(keys)) {
        push(out, keys[i])
        i = i + 1
    }
    let a = 0
    while (a < len(out)) {
        let b = a + 1
        while (b < len(out)) {
            if (out[b] < out[a]) {
                let t = out[a]
                out[a] = out[b]
                out[b] = t
            }
            b = b + 1
        }
        a = a + 1
    }
    return out
}
