// app.kark — A11 Documentation Generator (Phase 005).
//
// Usage (built binary): doc-gen <file> [file ...]
// Prints per-file function signatures and comment counts using textual
// heuristics only. Not a parser/AST tool. See README.rst.
import doc_scan

func main() {
    let args = getArgs()
    if (len(args) < 2) {
        println("Usage: doc-gen <file> [file ...]")
        return
    }
    let i = 1
    while (i < len(args)) {
        let base = doc_scan.doc_basename(args[i])
        let r = doc_scan.doc_scan(args[i])
        if (r["ok"] == 0) {
            println("## " + base)
            println("error: cannot read")
            i = i + 1
            continue
        }
        println("## " + base)
        println("funcs:")
        let funcs = r["funcs"]
        if (len(funcs) == 0) {
            println("(none)")
        }
        let j = 0
        while (j < len(funcs)) {
            println("- " + funcs[j])
            j = j + 1
        }
        println("comments: " + str(r["comments"]))
        i = i + 1
    }
}
