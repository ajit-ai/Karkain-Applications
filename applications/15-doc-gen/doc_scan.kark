// doc_scan.kark — textual doc extraction for A11 (Phase 005).
//
// Heuristics (NOT AST parsing): a "function" is a non-comment line whose
// trimmed form starts with "func " or "public func "; its signature is the
// trimmed line. A "doc comment" is a non-empty trimmed line starting with
// "//". Comment lines are never counted as functions.
//
// Returns { ok, error, funcs, comments } where funcs is an array of
// signature strings in file order.

// doc_starts reports whether s starts with prefix.
public func doc_starts(s, prefix) {
    if (len(prefix) > len(s)) {
        return 0
    }
    if (substr(s, 0, len(prefix)) == prefix) {
        return 1
    }
    return 0
}

// doc_basename strips directories (both "/" and "\") from path.
public func doc_basename(path) {
    let cut = 0
    let i = 0
    while (i < len(path)) {
        if (substr(path, i, 1) == "/") {
            cut = i + 1
        }
        if (substr(path, i, 1) == "\\") {
            cut = i + 1
        }
        i = i + 1
    }
    return substr(path, cut, len(path) - cut)
}

// doc_scan returns the doc summary for one file.
public func doc_scan(path) {
    let r = {}
    r["ok"] = 0
    r["error"] = ""
    r["funcs"] = []
    r["comments"] = 0
    let content = readFile(path)
    if (len(content) == 0) {
        r["error"] = "cannot read " + path
        return r
    }
    let funcs = []
    let comments = 0
    let lines = split(content, "\n")
    let i = 0
    while (i < len(lines)) {
        let t = trim(lines[i])
        i = i + 1
        if (len(t) == 0) {
            continue
        }
        if (doc_starts(t, "//") == 1) {
            comments = comments + 1
            continue
        }
        if (doc_starts(t, "func ") == 1) {
            push(funcs, t)
            continue
        }
        if (doc_starts(t, "public func ") == 1) {
            push(funcs, t)
            continue
        }
    }
    r["ok"] = 1
    r["funcs"] = funcs
    r["comments"] = comments
    return r
}
