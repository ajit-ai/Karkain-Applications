// explorer.kark — project exploration for A08 (Phase 005).
//
// Verified builtins only: listFiles / readFile / split / contains / len /
// push. Boundaries: listFiles is flat names-only (no type info, no
// recursion); readFile returns "" for missing, empty, and directory paths,
// so sizes of 0 mean "unreadable-or-empty" (documented).

// explorer_sort returns a sorted copy of a string array.
public func explorer_sort(names) {
    let out = []
    let i = 0
    while (i < len(names)) {
        push(out, names[i])
        i = i + 1
    }
    let a = 0
    while (a < len(out)) {
        let b = a + 1
        while (b < len(out)) {
            if (out[b] < out[a]) {
                let t = out[a]
                out[a] = out[b]
                out[b] = t
            }
            b = b + 1
        }
        a = a + 1
    }
    return out
}

// explorer_scan returns { ok, error, entries, total_chars, kark_files,
// manifest } for dir. entries is a sorted array of [name, chars].
public func explorer_scan(dir) {
    let r = {}
    r["ok"] = 0
    r["error"] = ""
    r["entries"] = []
    r["total_chars"] = 0
    r["kark_files"] = 0
    r["manifest"] = 0
    let names = explorer_sort(listFiles(dir))
    if (len(names) == 0) {
        r["error"] = "cannot list " + dir
        return r
    }
    let entries = []
    let total = 0
    let nkark = 0
    let manifest = 0
    let i = 0
    while (i < len(names)) {
        let c = readFile(dir + "/" + names[i])
        let entry = []
        push(entry, names[i])
        push(entry, len(c))
        push(entries, entry)
        total = total + len(c)
        if (explorer_is_kark(names[i]) == 1) {
            nkark = nkark + 1
        }
        if (names[i] == "karkain.toml") {
            manifest = 1
        }
        i = i + 1
    }
    r["ok"] = 1
    r["entries"] = entries
    r["total_chars"] = total
    r["kark_files"] = nkark
    r["manifest"] = manifest
    return r
}

// explorer_is_kark reports whether name ends with ".kark".
public func explorer_is_kark(name) {
    if (len(name) < 5) {
        return 0
    }
    if (substr(name, len(name) - 5, 5) == ".kark") {
        return 1
    }
    return 0
}
