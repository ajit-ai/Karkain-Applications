// taskdb.kark — file-backed task persistence for A22 (Phase 006).
//
// Format (documented, deterministic, line-oriented):
//   #karkain-tasks-v1
//   task|<id>|<title>|<state>
//   next|<n>
// Titles may not contain "|" (rejected at create time); newlines cannot
// arrive through the tested paths. Missing/empty files load as an empty
// store. State values are open/done. Built on tasks.kark operations and
// verified builtins (readFile/writeFile/split/trim/substr/int/len/push).

// taskdb_has_bar reports whether s contains "|".
public func taskdb_has_bar(s) {
    let i = 0
    while (i < len(s)) {
        if (s[i] == "|") {
            return 1
        }
        i = i + 1
    }
    return 0
}

// taskdb_load reads path into a tasks store map.
public func taskdb_load(path) {
    let store = tasks.tasks_new()
    let content = readFile(path)
    if (len(content) == 0) {
        return store
    }
    let ids = []
    let titles = []
    let states = []
    let next = 1
    let lines = split(content, "\n")
    let i = 0
    while (i < len(lines)) {
        let line = trim(lines[i])
        i = i + 1
        if (len(line) == 0) {
            continue
        }
        if (substr(line, 0, 1) == "#") {
            continue
        }
        let fields = split(line, "|")
        if (len(fields) < 2) {
            continue
        }
        if (trim(fields[0]) == "next") {
            next = int(trim(fields[1]))
            continue
        }
        if (trim(fields[0]) == "task") {
            if (len(fields) < 4) {
                continue
            }
            push(ids, int(trim(fields[1])))
            push(titles, trim(fields[2]))
            push(states, trim(fields[3]))
            continue
        }
    }
    store["ids"] = ids
    store["titles"] = titles
    store["states"] = states
    store["next"] = next
    return store
}

// taskdb_save writes store to path. Returns 1/0.
public func taskdb_save(path, store) {
    let text = "#karkain-tasks-v1\n"
    let i = 0
    while (i < len(store["ids"])) {
        text = text + "task|" + str(store["ids"][i]) + "|" + store["titles"][i] + "|" + store["states"][i] + "\n"
        i = i + 1
    }
    text = text + "next|" + str(store["next"]) + "\n"
    return writeFile(path, text)
}
