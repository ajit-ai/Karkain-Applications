// app.kark — A62 Full-Stack Task Operations, CLI + HTTP + DB (Phase 010).
//
// Service layer is the verified A22 stack, reused verbatim: HTTP codec
// -> dispatch -> tasks store -> taskdb file (single-threaded server).
// New in A62: ops CLI modes that drive the full chain end to end and do
// client-side work (id parsing, summary aggregation, CSV export).
// Modes (built binary):
//   taskops server <port> <maxRequests> <dbfile>
//   taskops client <host> <port> <method> <path> [body]
//   taskops op-create <host> <port> <title>
//   taskops op-list <host> <port>
//   taskops op-complete <host> <port> <id>
//   taskops op-summary <host> <port>
//   taskops op-export <host> <port>
// Deterministic runs start from a fresh (missing/empty) dbfile, which the
// service creates on first save.
import http_codec
import tasks
import taskdb

func svc_usage() {
    println("Usage: taskops server <port> <maxRequests> <dbfile>")
    println("Usage: taskops client <host> <port> <method> <path> [body]")
    println("Usage: taskops op-create <host> <port> <title>")
    println("Usage: taskops op-list <host> <port>")
    println("Usage: taskops op-complete <host> <port> <id>")
    println("Usage: taskops op-summary <host> <port>")
    println("Usage: taskops op-export <host> <port>")
}

public func svc_dispatch(conn, store, dbfile, req) {
    let status = 404
    let reason = "Not Found"
    let body = "error: not found"
    let segs = split(req["path"], "/")
    if (len(segs) == 1) {
        if (segs[0] == "tasks") {
            if (req["method"] == "GET") {
                status = 200
                reason = "OK"
                body = tasks.tasks_list(store)
            }
            if (req["method"] == "POST") {
                if (taskdb.taskdb_has_bar(req["body"]) == 1) {
                    status = 400
                    reason = "Bad Request"
                    body = "error: bad title"
                } else {
                    let made = tasks.tasks_create(store, req["body"])
                    if (made["ok"] == 1) {
                        if (taskdb.taskdb_save(dbfile, store) == 1) {
                            status = 201
                            reason = "Created"
                            body = "created: " + str(made["id"])
                        } else {
                            status = 500
                            reason = "Internal Server Error"
                            body = "error: save failed"
                        }
                    } else {
                        status = 400
                        reason = "Bad Request"
                        body = "error: " + made["error"]
                    }
                }
            }
        }
    }
    if (len(segs) == 2) {
        if (segs[0] == "tasks") {
            if (tasks.tasks_is_digits(segs[1]) == 1) {
                let id = int(segs[1])
                if (req["method"] == "GET") {
                    let pos = tasks.tasks_index(store, id)
                    if (pos >= 0) {
                        status = 200
                        reason = "OK"
                        body = tasks.tasks_format(store, pos)
                    }
                }
                if (req["method"] == "PUT") {
                    let upd = tasks.tasks_set_state(store, id, trim(req["body"]))
                    if (upd["ok"] == 1) {
                        if (taskdb.taskdb_save(dbfile, store) == 1) {
                            status = 200
                            reason = "OK"
                            body = "updated: " + str(id)
                        } else {
                            status = 500
                            reason = "Internal Server Error"
                            body = "error: save failed"
                        }
                    } else {
                        if (upd["error"] == "not found") {
                            status = 404
                            reason = "Not Found"
                            body = "error: not found"
                        } else {
                            status = 400
                            reason = "Bad Request"
                            body = "error: " + upd["error"]
                        }
                    }
                }
                if (req["method"] == "DELETE") {
                    if (tasks.tasks_remove(store, id) == 1) {
                        if (taskdb.taskdb_save(dbfile, store) == 1) {
                            status = 200
                            reason = "OK"
                            body = "deleted: " + str(id)
                        } else {
                            status = 500
                            reason = "Internal Server Error"
                            body = "error: save failed"
                        }
                    }
                }
            }
        }
    }
    let pkt = http_codec.http_build_response(status, reason, body)
    net_write(conn, pkt)
    println("server: " + req["method"] + " " + req["path"] + " -> " + str(status))
    return 1
}

func svc_serve(port, maxRequests, dbfile) {
    let store = taskdb.taskdb_load(dbfile)
    let srv = net_listen("127.0.0.1", port)
    if (srv < 0) {
        println("server: listen failed: " + net_last_error())
        return
    }
    println("server: listening 127.0.0.1:" + str(port))
    let done = 0
    while (done < maxRequests) {
        let conn = net_accept(srv)
        if (conn < 0) {
            println("server: accept failed: " + net_last_error())
            break
        }
        let req = http_codec.http_read_request(conn)
        if (req["ok"] == 0) {
            println("server: bad request: " + req["error"])
            net_close(conn)
            done = done + 1
            continue
        }
        svc_dispatch(conn, store, dbfile, req)
        net_close(conn)
        done = done + 1
    }
    net_close(srv)
}

func svc_client(host, port, method, path, body) {
    let resp = http_codec.http_request(host, port, method, path, body)
    if (resp["ok"] == 0) {
        println("client: request failed: " + resp["error"])
        return
    }
    println("client: status " + str(resp["status"]))
    println("client: body " + resp["body"])
}

// op_get fetches the raw task-list body; prints an error on failure.
func op_get(host, port) {
    let resp = http_codec.http_request(host, port, "GET", "/tasks", "")
    if (resp["ok"] == 0) {
        println("op: request failed: " + resp["error"])
        return ""
    }
    if (resp["status"] != 200) {
        println("op: bad status " + str(resp["status"]))
        return ""
    }
    return resp["body"]
}

// op_state_of extracts open/done from an "id: title [state]" line.
func op_state_of(line) {
    let n = len(line)
    if (n >= 6) {
        if (substr(line, n - 6, 6) == "[done]") {
            return "done"
        }
    }
    if (n >= 6) {
        if (substr(line, n - 6, 6) == "[open]") {
            return "open"
        }
    }
    return ""
}

// op_id_of extracts the id prefix before the first ": ".
func op_id_of(line) {
    let at = ops_find(line, ": ")
    if (at < 0) {
        return ""
    }
    return substr(line, 0, at)
}

// ops_find returns the first index of sub in text, or -1.
func ops_find(text, sub) {
    let n = len(text)
    let m = len(sub)
    if (m == 0) {
        return 0
    }
    let i = 0
    while (i <= n - m) {
        if (substr(text, i, m) == sub) {
            return i
        }
        i = i + 1
    }
    return -1
}

func op_create(host, port, title) {
    let resp = http_codec.http_request(host, port, "POST", "/tasks", title)
    if (resp["ok"] == 0) {
        println("op: request failed: " + resp["error"])
        return
    }
    if (resp["status"] != 201) {
        println("op: create failed: " + resp["body"])
        return
    }
    let parts = split(resp["body"], ": ")
    println("op: created " + trim(parts[len(parts) - 1]))
}

func op_list(host, port) {
    let body = op_get(host, port)
    if (len(body) == 0) {
        return
    }
    let lines = split(body, "\n")
    let i = 0
    while (i < len(lines)) {
        println("op: " + lines[i])
        i = i + 1
    }
}

func op_complete(host, port, id) {
    let resp = http_codec.http_request(host, port, "PUT", "/tasks/" + id, "done")
    if (resp["ok"] == 0) {
        println("op: request failed: " + resp["error"])
        return
    }
    println("op: " + resp["body"])
}

func op_summary(host, port) {
    let body = op_get(host, port)
    if (len(body) == 0) {
        return
    }
    let lines = split(body, "\n")
    let open = 0
    let done = 0
    let i = 1
    while (i < len(lines)) {
        let st = op_state_of(trim(lines[i]))
        if (st == "open") {
            open = open + 1
        }
        if (st == "done") {
            done = done + 1
        }
        i = i + 1
    }
    println("op: total=" + str(open + done) + " open=" + str(open) + " done=" + str(done))
}

func op_export(host, port) {
    let body = op_get(host, port)
    if (len(body) == 0) {
        return
    }
    println("id,title,state")
    let lines = split(body, "\n")
    let i = 1
    while (i < len(lines)) {
        let line = trim(lines[i])
        i = i + 1
        if (len(line) == 0) {
            continue
        }
        let st = op_state_of(line)
        let id = op_id_of(line)
        let title = line
        let at = ops_find(line, ": ")
        if (at >= 0) {
            title = trim(substr(line, at + 2, len(line) - at - 8))
        }
        println(id + "," + title + "," + st)
    }
}

func main() {
    let args = getArgs()
    if (len(args) < 2) {
        svc_usage()
        return
    }
    if (args[1] == "server") {
        if (len(args) < 5) {
            svc_usage()
            return
        }
        svc_serve(int(args[2]), int(args[3]), args[4])
        return
    }
    if (args[1] == "client") {
        if (len(args) < 6) {
            svc_usage()
            return
        }
        let body = ""
        if (len(args) > 6) {
            body = args[6]
        }
        svc_client(args[2], int(args[3]), args[4], args[5], body)
        return
    }
    if (args[1] == "op-create") {
        if (len(args) < 5) {
            svc_usage()
            return
        }
        op_create(args[2], int(args[3]), args[4])
        return
    }
    if (args[1] == "op-list") {
        if (len(args) < 4) {
            svc_usage()
            return
        }
        op_list(args[2], int(args[3]))
        return
    }
    if (args[1] == "op-complete") {
        if (len(args) < 5) {
            svc_usage()
            return
        }
        op_complete(args[2], int(args[3]), args[4])
        return
    }
    if (args[1] == "op-summary") {
        if (len(args) < 4) {
            svc_usage()
            return
        }
        op_summary(args[2], int(args[3]))
        return
    }
    if (args[1] == "op-export") {
        if (len(args) < 4) {
            svc_usage()
            return
        }
        op_export(args[2], int(args[3]))
        return
    }
    svc_usage()
}
