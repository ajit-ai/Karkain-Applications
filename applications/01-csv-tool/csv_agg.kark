// csv_agg.kark — aggregation for A05 (Phase 002).
//
// Uses only verified Karkain 1.1.0 builtins (len/push/hasKey/map_keys_of)
// so the module runs from any directory without std.* resolution.

// csv_agg_stats returns { count, sum, min, max, avg } over rows where each
// row is [category, value]. avg uses integer arithmetic. Empty input yields
// all zeros.
public func csv_agg_stats(rows) {
    let st = {}
    st["count"] = 0
    st["sum"] = 0
    st["min"] = 0
    st["max"] = 0
    st["avg"] = 0
    if (len(rows) == 0) {
        return st
    }
    let total = 0
    let lo = rows[0][1]
    let hi = rows[0][1]
    let i = 0
    while (i < len(rows)) {
        let v = rows[i][1]
        total = total + v
        if (v < lo) {
            lo = v
        }
        if (v > hi) {
            hi = v
        }
        i = i + 1
    }
    st["count"] = len(rows)
    st["sum"] = total
    st["min"] = lo
    st["max"] = hi
    st["avg"] = total / len(rows)
    return st
}

// csv_agg_groups returns a map category -> [count, sum].
public func csv_agg_groups(rows) {
    let counts = {}
    let sums = {}
    let i = 0
    while (i < len(rows)) {
        let cat = rows[i][0]
        let val = rows[i][1]
        if (hasKey(sums, cat) == 1) {
            sums[cat] = sums[cat] + val
            counts[cat] = counts[cat] + 1
        } else {
            sums[cat] = val
            counts[cat] = 1
        }
        i = i + 1
    }
    let groups = {}
    let keys = map_keys_of(sums)
    let k = 0
    while (k < len(keys)) {
        let entry = []
        push(entry, counts[keys[k]])
        push(entry, sums[keys[k]])
        groups[keys[k]] = entry
        k = k + 1
    }
    return groups
}

// csv_agg_sort returns a sorted copy of the input string array (bubble
// sort), leaving the input untouched. Guarantees deterministic group order
// regardless of map iteration order.
public func csv_agg_sort(keys) {
    let out = []
    let i = 0
    while (i < len(keys)) {
        push(out, keys[i])
        i = i + 1
    }
    let a = 0
    while (a < len(out)) {
        let b = a + 1
        while (b < len(out)) {
            if (out[b] < out[a]) {
                let t = out[a]
                out[a] = out[b]
                out[b] = t
            }
            b = b + 1
        }
        a = a + 1
    }
    return out
}
