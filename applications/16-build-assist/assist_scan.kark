// assist_scan.kark — project checks for A12 (Phase 005).
//
// Name-based checks only (no stat API exists, CAP-009): manifest presence
// (karkain.toml by name), entrypoint presence (app.kark or main.kark by
// name), .kark count by suffix. Returns { entries, kark_files, manifest,
// entrypoint, entry_name }.

// assist_is_kark reports whether name ends with ".kark".
public func assist_is_kark(name) {
    if (len(name) < 5) {
        return 0
    }
    if (substr(name, len(name) - 5, 5) == ".kark") {
        return 1
    }
    return 0
}

// assist_sort returns a sorted copy of a string array.
public func assist_sort(names) {
    let out = []
    let i = 0
    while (i < len(names)) {
        push(out, names[i])
        i = i + 1
    }
    let a = 0
    while (a < len(out)) {
        let b = a + 1
        while (b < len(out)) {
            if (out[b] < out[a]) {
                let t = out[a]
                out[a] = out[b]
                out[b] = t
            }
            b = b + 1
        }
        a = a + 1
    }
    return out
}

// assist_basename strips directories (both "/" and "\") from path.
public func assist_basename(path) {
    let cut = 0
    let i = 0
    while (i < len(path)) {
        if (substr(path, i, 1) == "/") {
            cut = i + 1
        }
        if (substr(path, i, 1) == "\\") {
            cut = i + 1
        }
        i = i + 1
    }
    return substr(path, cut, len(path) - cut)
}

// assist_scan returns the project summary for dir.
public func assist_scan(dir) {
    let r = {}
    r["ok"] = 0
    r["error"] = ""
    r["entries"] = 0
    r["kark_files"] = 0
    r["manifest"] = 0
    r["entrypoint"] = 0
    r["entry_name"] = ""
    let names = assist_sort(listFiles(dir))
    if (len(names) == 0) {
        r["error"] = "cannot list " + dir
        return r
    }
    let nkark = 0
    let manifest = 0
    let entrypoint = 0
    let entry_name = ""
    let i = 0
    while (i < len(names)) {
        if (assist_is_kark(names[i]) == 1) {
            nkark = nkark + 1
        }
        if (names[i] == "karkain.toml") {
            manifest = 1
        }
        if (names[i] == "app.kark") {
            entrypoint = 1
            entry_name = "app.kark"
        }
        if (names[i] == "main.kark") {
            if (entrypoint == 0) {
                entry_name = "main.kark"
            }
            entrypoint = 1
        }
        i = i + 1
    }
    r["ok"] = 1
    r["entries"] = len(names)
    r["kark_files"] = nkark
    r["manifest"] = manifest
    r["entrypoint"] = entrypoint
    r["entry_name"] = entry_name
    return r
}
