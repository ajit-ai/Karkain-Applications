// pool.kark — Phase 007 worker/pipeline/grid primitives (A25-A27, A29-A30).
//
// Proven runtime facts (sandbox probes, documented in CAPABILITY.rst):
//   spawn(f, args...) + join(handle) carry INT results only; map/array/
//   string returns arrive empty. Channels carry maps fine; multiple
//   consumers share one channel. readFile works inside spawned tasks.
//   Workers stop on sentinel maps (no close-detection primitive).
// All cross-task results therefore flow through result channels as
// {id, out} maps; main normalizes order by id before printing.

// pool_worker runs jobs from jobs until a {stop} sentinel, sending
// {id, out} results to results. Job: {id, n} -> out = n*n.
public func pool_worker(jobs, results) {
    while (1 == 1) {
        let job = receive(jobs)
        if (hasKey(job, "stop") == 1) {
            break
        }
        let r = {}
        r["id"] = job["id"]
        r["out"] = job["n"] * job["n"]
        chanSend(results, r)
    }
    return 0
}

// pipe_worker doubles {id, v} jobs into {id, out} results (A26 stage).
public func pipe_worker(jobs, results) {
    while (1 == 1) {
        let job = receive(jobs)
        if (hasKey(job, "stop") == 1) {
            break
        }
        let r = {}
        r["id"] = job["id"]
        r["out"] = job["v"] + job["v"]
        chanSend(results, r)
    }
    return 0
}

// tag_worker classifies {id, v} jobs: out 1 when v > 3 else 0 (A29).
public func tag_worker(jobs, results) {
    while (1 == 1) {
        let job = receive(jobs)
        if (hasKey(job, "stop") == 1) {
            break
        }
        let r = {}
        r["id"] = job["id"]
        r["out"] = 0
        if (job["v"] > 3) {
            r["out"] = 1
        }
        chanSend(results, r)
    }
    return 0
}

// cell computes one grid cell (A30). Int-only so join() carries it.
public func cell(row, col) {
    return (row + 1) * (col + 1)
}

// countlines counts non-blank lines (A27). Int-only for join().
public func countlines(path) {
    let text = readFile(path)
    let lines = split(text, "\n")
    let n = 0
    let i = 0
    while (i < len(lines)) {
        if (len(trim(lines[i])) > 0) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// sort_ids sorts parallel id/out arrays by id ascending (bubble sort).
public func sort_ids(ids, outs) {
    let i = 0
    while (i < len(ids)) {
        let j = i + 1
        while (j < len(ids)) {
            if (ids[j] < ids[i]) {
                let t = ids[i]
                ids[i] = ids[j]
                ids[j] = t
                let u = outs[i]
                outs[i] = outs[j]
                outs[j] = u
            }
            j = j + 1
        }
        i = i + 1
    }
    return 0
}
