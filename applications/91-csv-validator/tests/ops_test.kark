// Round 2 REAL CSV validation tests (self-contained; no imports, no file I/O).
// The empty main() marker keeps this test file out of the project-aware sibling
// module scope (which otherwise injects test functions twice and breaks the C
// compile in this repo). It is never invoked by the test harness.
func main() {
}

func test_expected_header_and_columns() {
    let expected_header = "id,name,amount"
    let expected_cols = 3
    let h = split(expected_header, ",")
    assert_eq(expected_header, "id,name,amount")
    assert_eq(len(h), expected_cols)
    assert_eq(h[0], "id")
    assert_eq(h[2], "amount")
}

func test_row_column_check_core() {
    let rows = ["1,alpha,100", "2,beta", "3,gamma,300,extra"]
    let expected_cols = 3
    let valid = 0
    let invalid = 0
    let i = 0
    while (i < len(rows)) {
        let cols = split(rows[i], ",")
        if (len(cols) == expected_cols) { valid = valid + 1 } else { invalid = invalid + 1 }
        i = i + 1
    }
    assert_eq(valid, 1)
    assert_eq(invalid, 2)
}

func test_csv_filename_filter_core() {
    let files = ["good.csv", "bad_rows.csv", "state.dat", "report.dat"]
    let csvs = []
    let i = 0
    while (i < len(files)) {
        if (contains(files[i], ".csv")) { push(csvs, files[i]) }
        i = i + 1
    }
    assert_eq(len(csvs), 2)
    assert_eq(csvs[0], "good.csv")
    assert_eq(csvs[1], "bad_rows.csv")
}
